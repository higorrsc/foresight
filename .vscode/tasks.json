{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format

  "version": "2.0.0",
  "tasks": [
    {
      "label": "install",
      "type": "shell",
      "command": "echo \"📦 Installing project dependencies...\" && uv sync",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "run",
      "type": "shell",
      "command": "echo \"🚀 Starting API at http://127.0.0.1:8000...\" && uv run uvicorn src.api.main:app --reload",
      "isBackground": true,
      "group": {
        "kind": "none",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "echo \"🎨 Formatting code with ruff...\" && uv run ruff format . && uv run ruff check --fix .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "echo \"🔍 Running lint checks with ruff...\" && uv run ruff check . && uv run ruff format --check .",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "type-check",
      "type": "shell",
      "command": "echo \"🧠 Running type checks with mypy...\" && uv run mypy .",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "echo \"🧪 Running test suite with pytest...\" && uv run pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "coverage",
      "type": "shell",
      "command": "echo \"🧪 Generating test coverage report...\" && uv run pytest --cov=src --cov-report=term-missing --cov-report=html",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "check",
      "type": "shell",
      "dependsOn": ["lint", "type-check", "test"],
      "command": "echo \"✅ All quality checks passed successfully!\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "generate-secret",
      "type": "shell",
      "command": "echo \"🔐 Generating project secret...\" && python -c \"import secrets; print(secrets.token_hex(32))\"",
      "group": "none",
      "problemMatcher": []
    }
  ]
}
