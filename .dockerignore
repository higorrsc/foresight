# Include any files or directories that you don't want to be copied to your
# container here (e.g., local build artifacts, temporary files, etc.).
#
# For more help, visit the .dockerignore file reference guide at
# https://docs.docker.com/go/build-context-dockerignore/

# Git
.git
.gitignore

# Docker
docker-compose*
compose.y*ml

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checker / linters
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Logs / databases
*.log
*.sqlite3
*.sqlite3-journal

# Node
node_modules/
npm-debug.log*

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store

# Environment files
.env
.env.*
!.env.example

# Documentation build
docs/_build/

# Local configs
local_settings.py

# Temporary files
.cache/
tmp/
temp/

# Kubernetes / Helm
charts/

# Optional
tests/
README.md
LICENSE
