# Configurações de banco de dados para o ambiente de desenvolvimento.
# Basta comentar/descomentar os blocos para trocar de SGBD.

# --- Bloco 1: SQLite (Padrão) ---
DB_DRIVER="sqlite"
# Para SQLite, DB_DATABASE é o caminho para o ficheiro. Os outros são ignorados.
DB_DATABASE="./foresight.db"


# --- Bloco 2: PostgreSQL (Exemplo) ---
# DB_DRIVER="postgresql+psycopg2"
# DB_USER="foresight_user"
# DB_PASSWORD="foresight_password"
# DB_HOST="localhost"
# DB_PORT=5432
# DB_DATABASE="foresight_db"


# --- Bloco 3: SQL Server com Trusted Connection (Exemplo) ---
# DB_DRIVER="mssql+pyodbc"
# DB_HOST="NOME_DO_SERVIDOR"
# DB_DATABASE="foresight_db"
# DB_USER= # Deixe em branco
# DB_PASSWORD= # Deixe em branco
# Adicione aqui quaisquer outros parâmetros necessários para o driver,
# como o nome do driver ODBC. A montagem da URL pode ser ajustada na classe Settings.

# --- Configurações de Autenticação JWT ---
# IMPORTANTE: Gere uma chave secreta forte e única para o seu ambiente de produção.
# Pode usar o comando `openssl rand -hex 32` no terminal para gerar uma.
SECRET_KEY="uma-chave-secreta-de-exemplo-altere-isto"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_PROVIDER="local"
