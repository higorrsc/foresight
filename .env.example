# Configurações de banco de dados para o ambiente de desenvolvimento.
# Basta comentar/descomentar os blocos para trocar de SGBD.

# --- Bloco 1: SQLite (Padrão) ---
DB_DRIVER="sqlite"
DB_DATABASE="./foresight.db" # Para SQLite, DB_DATABASE é o caminho para o ficheiro. Os outros são ignorados.

# --- Bloco 2: PostgreSQL (Exemplo) ---
# DB_DRIVER="postgresql+asyncpg"
# DB_USER="foresight_user"
# DB_PASSWORD="foresight_password"
# DB_HOST="localhost"
# DB_PORT=5432
# DB_DATABASE="foresight_db"

# --- Bloco 3: SQL Server (Exemplo) ---
# DB_DRIVER="mssql+aioodbc"
# DB_HOST="NOME_DO_SERVIDOR"
# DB_DATABASE="foresight_db"
# DB_USER="foresight_user" # Deixe em branco para usar com o Trusted Connection
# DB_PASSWORD="foresight_password" # Deixe em branco para usar com o Trusted Connection
# Adicione aqui quaisquer outros parâmetros necessários para o driver,
# como o nome do driver ODBC. A montagem da URL pode ser ajustada na classe Settings.

# --- Bloco 4: CockroachDB (Exemplo) ---
# DB_DRIVER="cockroachdb"
# DB_USER="foresight_sysadmin"
# DB_PASSWORD="cockroach.password"
# DB_HOST="cockroachdb-cluster.address"
# DB_PORT=cockroachdb-cluster.port
# DB_DATABASE="cockroachdb-cluster.database"
# DB_SSL_ROOT_CERT="ca.crt"

# --- Configurações de Autenticação JWT ---
# IMPORTANTE: Gere uma chave secreta forte e única para o seu ambiente de produção.
# Pode usar o comando `openssl rand -hex 32` no terminal para gerar uma.
SECRET_KEY="uma-chave-secreta-de-exemplo-altere-isto"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_PROVIDER="local"

# --- Configurações de Teste ---
# Define se os testes devem usar um banco em memória ou um ficheiro.
# "true" para em memória (rápido), "false" para ficheiro (bom para depurar).
TEST_IN_MEMORY="true"
